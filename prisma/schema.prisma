generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  name          String?
  active        Boolean  @default(true)
  // STAFF | MANAGER | ADMIN
  role          String   @default("STAFF")
  adObjectId    String?  @unique
  manager       User?    @relation("UserManager", fields: [managerId], references: [id])
  managerId     String?
  reports       User[]   @relation("UserManager")
  reservations  Reservation[]
  seatAssignments      SeatAssignment[] @relation("AssignmentUser")
  requestedAssignments SeatAssignment[] @relation("AssignmentRequester")
  reviewedAssignments  SeatAssignment[] @relation("AssignmentReviewer")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Building {
  id         String   @id @default(cuid())
  name       String
  address    String?
  floorCount Int      @default(0)
  // IANA zone (e.g. "America/Chicago") used to interpret seat assignment hours; falls back to APP_TIMEZONE
  timezone   String?
  floors     Floor[]
}

model Floor {
  id         String     @id @default(cuid())
  building   Building   @relation(fields: [buildingId], references: [id])
  buildingId String
  name       String
  order      Int
  svgContent String?
  imageContent String?
  locations  Location[]
}

model Location {
  id           String    @id @default(cuid())
  label        String
  type         String
  floor        Floor     @relation(fields: [floorId], references: [id])
  floorId      String
  parent       Location? @relation("LocationParent", fields: [parentId], references: [id])
  parentId     String?
  children     Location[] @relation("LocationParent")
  polygon      LocationPolygon?
  imageUrl     String?
  seatAssignments SeatAssignment[]
  reservations Reservation[]
}

model LocationPolygon {
  id         String   @id @default(cuid())
  location   Location @relation(fields: [locationId], references: [id])
  locationId String   @unique
  // store SVG polygon points as simple stringified array: [[x,y],[x,y],...]
  points     String
  editable   Boolean  @default(true)
}

// A recurring weekly claim on a location by one staff member (their assigned seat).
// While APPROVED, matching days/hours cannot be reserved by anyone else.
model SeatAssignment {
  id            String    @id @default(cuid())
  location      Location  @relation(fields: [locationId], references: [id], onDelete: Cascade)
  locationId    String
  user          User      @relation("AssignmentUser", fields: [userId], references: [id])
  userId        String
  // comma-separated weekdays, 0 = Sunday ... 6 = Saturday, e.g. "1,2,3,4,5"
  daysOfWeek    String
  // wall-clock minutes from midnight in the building's timezone; end is exclusive
  startMinute   Int
  endMinute     Int
  // effective local dates (YYYY-MM-DD); endDate null = open-ended
  startDate     String
  endDate       String?
  // PENDING | APPROVED | REJECTED | CANCELLED
  status        String    @default("PENDING")
  note          String?
  requestedBy   User      @relation("AssignmentRequester", fields: [requestedById], references: [id])
  requestedById String
  reviewedBy    User?     @relation("AssignmentReviewer", fields: [reviewedById], references: [id])
  reviewedById  String?
  reviewedAt    DateTime?
  reviewNote    String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([locationId, status])
  @@index([userId])
}

model Reservation {
  id          String   @id @default(cuid())
  location    Location @relation(fields: [locationId], references: [id])
  locationId  String
  user        User     @relation(fields: [userId], references: [id])
  userId      String
  start       DateTime
  end         DateTime
  approved    Boolean  @default(false)
  createdAt   DateTime @default(now())
}
