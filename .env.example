# Copy to .env and fill values
DATABASE_URL="file:./dev.db"
NEXTAUTH_URL=http://localhost:3000
# Set a strong NEXTAUTH_SECRET to avoid NextAuth warnings. Generate with e.g. `openssl rand -hex 32`.
NEXTAUTH_SECRET=
# Azure AD / Microsoft identity
AZURE_AD_CLIENT_ID=
AZURE_AD_CLIENT_SECRET=
AZURE_AD_TENANT_ID=

# SMTP for email notifications
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# App admin email (optional)
ADMIN_EMAIL=
