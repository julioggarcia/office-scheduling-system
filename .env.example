# Copy to .env and fill values
DATABASE_URL="file:./dev.db"
NEXTAUTH_URL=http://localhost:3000
# Required (sessions are signed with it). Generate with e.g. `openssl rand -hex 32`.
NEXTAUTH_SECRET=

# Microsoft Entra ID (Azure AD) sign-in. Register an app with redirect URI
#   <NEXTAUTH_URL>/api/auth/callback/azure-ad
AZURE_AD_CLIENT_ID=
AZURE_AD_CLIENT_SECRET=
AZURE_AD_TENANT_ID=

# Local development only: sign in as any email without Microsoft. Ignored in production builds.
AUTH_DEV_LOGIN=false

# Comma-separated emails promoted to ADMIN when they sign in (bootstraps the first admin)
ADMIN_EMAILS=

# Default timezone (IANA name, e.g. America/Chicago) for buildings that don't set one
APP_TIMEZONE=

# SMTP for email notifications
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Fallback recipient for seat requests from staff without a manager (optional)
ADMIN_EMAIL=
